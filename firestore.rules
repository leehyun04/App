rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // pairs/{6자리 코드} 문서에 host / guest 위치가 저장됩니다.
    // MVP용 규칙: 코드를 아는 사람만 읽고 쓸 수 있습니다. (코드 자체가 비밀키 역할)
    // 운영 시에는 Firebase Auth를 붙여 request.auth 기반으로 제한하세요.
    match /pairs/{code} {
      allow read, write: if code.matches('^[0-9]{6}$');
    }
  }
}
